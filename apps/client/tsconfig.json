{
    "extends": "./.nuxt/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "ignoreDeprecations": "5.0",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./src/*"],
            "#imports": ["./.nuxt/imports.d.ts"],
            "#build": ["./.nuxt"],
            "#build/*": ["./.nuxt/*"]
        },
        "types": ["node"]
    },
    "include": [
        ".nuxt/nuxt.d.ts",
        ".nuxt/types/**/*.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "nuxt.config.ts",
        "error.vue",
        "sentry.client.config.ts",
        "sentry.server.config.ts",
        "tests/**/*.ts",
        "playwright.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "dist", ".nuxt/pwa-icons-plugin.ts"]
}
