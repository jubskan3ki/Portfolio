{
    "name": "nuxt-app",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.13",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "preview:lhci": "NITRO_HOST=0.0.0.0 NITRO_PORT=4173 node .output/server/index.mjs",
        "postinstall": "nuxt prepare",
        "start": "nuxt start",
        "analyze": "ANALYZE=true nuxt build",
        "lint": "biome lint && oxlint",
        "lint:fix": "biome lint --write && oxlint --fix",
        "lint:css": "stylelint --allow-empty-input \"src/**/*.{css,scss,vue}\"",
        "format:css": "stylelint --fix --allow-empty-input \"src/**/*.{css,scss,vue}\"",
        "type-check": "nuxt prepare && vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:install": "playwright install chromium",
        "check": "bun run lint && bun run lint:css && bun run type-check && bun run test",
        "fix": "bun run lint:fix && bun run format:css",
        "api:generate-types": "openapi-typescript http://localhost:8000/api/schema/ -o src/types/api.generated.ts",
        "knip": "knip",
        "lighthouse:ci": "bunx @lhci/cli autorun --config=./lighthouserc.json",
        "lighthouse:desktop": "bunx lighthouse http://127.0.0.1:4173/ --preset=desktop --output=html --output-path=./.lighthouse-desktop-report.html",
        "lighthouse:mobile": "bunx lighthouse http://127.0.0.1:4173/ --output=html --output-path=./.lighthouse-mobile-report.html"
    },
    "dependencies": {
        "@nuxt/fonts": "^0.14.0",
        "@opentelemetry/auto-instrumentations-node": "^0.75.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
        "@opentelemetry/resources": "^1.30.0",
        "@opentelemetry/sdk-node": "^0.217.0",
        "@opentelemetry/semantic-conventions": "^1.28.0",
        "@pinia/nuxt": "^0.11.3",
        "@tanstack/vue-query": "^5.92.9",
        "@vueuse/core": "^14.2.1",
        "chart.js": "^4.5.1",
        "dayjs": "^1.11.19",
        "lucide-vue-next": "^0.575.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.29",
        "vue-router": "^5.0.3",
        "web-vitals": "^5.1.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.2",
        "@biomejs/biome": "2.4.15",
        "@nuxt/image": "^2.0.0",
        "@nuxtjs/seo": "^3.4.0",
        "@playwright/test": "^1.59.1",
        "@types/node": "^24.11.0",
        "@vite-pwa/nuxt": "^1.1.1",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vitest/coverage-v8": "^4.1.4",
        "@vue/test-utils": "^2.4.6",
        "happy-dom": "^20.9.0",
        "knip": "^5.85.0",
        "lint-staged": "^15.5.2",
        "nuxt": "^4.3.1",
        "nuxt-delay-hydration": "^1.3.8",
        "nuxt-security": "^2.2.0",
        "openapi-typescript": "^7.6.1",
        "oxlint": "1.66.0",
        "postcss-html": "^1.8.1",
        "postcss-scss": "^4.0.9",
        "rollup-plugin-visualizer": "^5.14.0",
        "sass": "^1.97.3",
        "stylelint": "^17.4.0",
        "stylelint-config-recommended-vue": "^1.6.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.3",
        "vitest": "^4.1.4",
        "vitest-axe": "^0.1.0",
        "vue-tsc": "^3.2.5"
    },
    "lint-staged": {
        "*.{ts,js,mjs,cjs,json}": [
            "biome lint --write --no-errors-on-unmatched"
        ],
        "*.{ts,tsx,js,mjs,cjs,vue}": [
            "oxlint --fix"
        ],
        "*.{css,scss}": [
            "stylelint --fix"
        ]
    },
    "overrides": {
        "serialize-javascript": ">=7.0.3",
        "svgo": ">=4.0.1",
        "immutable": ">=5.1.5",
        "tar": ">=7.5.11",
        "flatted": ">=3.4.2",
        "h3": ">=1.15.6",
        "fast-xml-parser": ">=5.5.6",
        "fast-xml-builder": ">=1.1.7",
        "node-forge": ">=1.4.0",
        "picomatch": ">=4.0.4",
        "vite": ">=8.0.8",
        "defu": ">=6.1.7",
        "lodash": ">=4.18.1",
        "lodash-es": ">=4.18.1",
        "protobufjs": ">=7.5.6",
        "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
        "js-cookie": ">=3.0.6",
        "fast-uri": ">=3.1.2",
        "simple-git": ">=3.36.0",
        "devalue": ">=5.8.1"
    },
    "trustedDependencies": [
        "vue-demi",
        "@parcel/watcher",
        "esbuild",
        "sharp",
        "unrs-resolver"
    ]
}
