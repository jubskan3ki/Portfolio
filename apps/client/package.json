{
    "name": "nuxt-app",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.28.0",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "preview:lhci": "NITRO_HOST=0.0.0.0 NITRO_PORT=4173 nuxt preview",
        "postinstall": "nuxt prepare",
        "start": "nuxt start",
        "analyze": "ANALYZE=true nuxt build",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "lint:css": "stylelint \"src/**/*.{css,scss,vue}\"",
        "format": "prettier --write \"**/*.{json,md,yaml,yml}\" --ignore-unknown",
        "format:css": "stylelint --fix \"src/**/*.{css,scss,vue}\"",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:install": "playwright install chromium",
        "check": "pnpm lint && pnpm lint:css && pnpm type-check && pnpm test",
        "fix": "pnpm lint:fix && pnpm format:css",
        "api:generate-types": "openapi-typescript http://localhost:8000/api/schema/ -o src/types/api.generated.ts",
        "knip": "knip",
        "lighthouse:ci": "pnpm dlx @lhci/cli autorun --config=./lighthouserc.json",
        "lighthouse:desktop": "pnpm dlx lighthouse http://127.0.0.1:4173/ --preset=desktop --output=html --output-path=./.lighthouse-desktop-report.html",
        "lighthouse:mobile": "pnpm dlx lighthouse http://127.0.0.1:4173/ --output=html --output-path=./.lighthouse-mobile-report.html"
    },
    "dependencies": {
        "@nuxt/fonts": "^0.14.0",
        "@opentelemetry/auto-instrumentations-node": "^0.54.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
        "@opentelemetry/resources": "^1.30.0",
        "@opentelemetry/sdk-node": "^0.57.0",
        "@opentelemetry/semantic-conventions": "^1.28.0",
        "@pinia/nuxt": "^0.11.3",
        "@tanstack/vue-query": "^5.92.9",
        "@vueuse/core": "^14.2.1",
        "chart.js": "^4.5.1",
        "dayjs": "^1.11.19",
        "lucide-vue-next": "^0.575.0",
        "pinia": "^3.0.4",
        "vue": "^3.5.29",
        "vue-router": "^5.0.3",
        "web-vitals": "^5.1.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.2",
        "@nuxt/eslint": "^1.15.2",
        "@nuxt/image": "^2.0.0",
        "@nuxtjs/seo": "^3.4.0",
        "@playwright/test": "^1.59.1",
        "@types/node": "^24.11.0",
        "@vite-pwa/nuxt": "^1.1.1",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vitest/coverage-v8": "^4.1.4",
        "@vue/test-utils": "^2.4.6",
        "eslint": "^9.39.2",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "happy-dom": "^20.9.0",
        "knip": "^5.85.0",
        "lint-staged": "^15.5.2",
        "nuxt": "^4.3.1",
        "nuxt-delay-hydration": "^1.3.8",
        "nuxt-security": "^2.2.0",
        "openapi-typescript": "^7.6.1",
        "postcss-html": "^1.8.1",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.8.1",
        "rollup-plugin-visualizer": "^5.14.0",
        "sass": "^1.97.3",
        "stylelint": "^17.4.0",
        "stylelint-config-recommended-vue": "^1.6.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "^5.9.3",
        "vite": "^8.0.3",
        "vitest": "^4.1.4",
        "vitest-axe": "^0.1.0",
        "vue-tsc": "^3.2.5"
    },
    "lint-staged": {
        "src/**/*.{ts,vue,js,mjs}": [
            "eslint --fix"
        ],
        "src/**/*.{css,scss}": [
            "stylelint --fix"
        ]
    },
    "pnpm": {
        "overrides": {
            "serialize-javascript": ">=7.0.3",
            "svgo": ">=4.0.1",
            "immutable": ">=5.1.5",
            "tar": ">=7.5.11",
            "flatted": ">=3.4.2",
            "h3": ">=1.15.6",
            "fast-xml-parser": ">=5.5.6",
            "node-forge": ">=1.4.0",
            "picomatch": ">=4.0.4",
            "vite": ">=8.0.8",
            "defu": ">=6.1.7",
            "lodash": ">=4.18.1",
            "lodash-es": ">=4.18.1"
        }
    }
}
