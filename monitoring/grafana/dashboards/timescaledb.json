            "type": "stat"
        },
        {
            "datasource": { "type": "postgres", "uid": "timescaledb" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "blue", "value": null }
                        ]
                    },
                    "unit": "none"
                }
            },
            "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
            "id": 2,
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": { "type": "postgres", "uid": "timescaledb" },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT count(*)::int AS value FROM timescaledb_information.chunks;",
                    "refId": "A"
                }
            ],
            "title": "Chunks total",
            "type": "stat"
        },
        {
            "datasource": { "type": "postgres", "uid": "timescaledb" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "orange", "value": 2 },
                            { "color": "green", "value": 4 }
                        ]
                    },
                    "unit": "none",
                    "decimals": 2
                }
            },
            "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
            "id": 3,
            "options": {
                "colorMode": "background",
                "graphMode": "area",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": { "type": "postgres", "uid": "timescaledb" },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT CASE WHEN sum(after_compression_total_bytes) = 0 THEN 0 ELSE sum(before_compression_total_bytes)::float / NULLIF(sum(after_compression_total_bytes), 0) END AS value FROM hypertable_compression_stats('web_vital_events') UNION ALL SELECT CASE WHEN sum(after_compression_total_bytes) = 0 THEN 0 ELSE sum(before_compression_total_bytes)::float / NULLIF(sum(after_compression_total_bytes), 0) END FROM hypertable_compression_stats('audit_logs');",
                    "refId": "A"
                }
            ],
            "title": "Ratio compression global (avg)",
            "type": "stat"
        },
        {
            "datasource": { "type": "postgres", "uid": "timescaledb" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null }
                        ]
                    },
                    "unit": "bytes"
                }
            },
            "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
            "id": 4,
            "options": {
                "colorMode": "background",
                "graphMode": "none",
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
                "textMode": "auto"
            },
            "targets": [
                {
                    "datasource": { "type": "postgres", "uid": "timescaledb" },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT COALESCE(sum(total_bytes), 0)::bigint AS value FROM hypertable_size('web_vital_events') UNION ALL SELECT COALESCE(sum(total_bytes), 0)::bigint FROM hypertable_size('audit_logs') UNION ALL SELECT COALESCE(sum(total_bytes), 0)::bigint FROM hypertable_size('webhook_deliveries') UNION ALL SELECT COALESCE(sum(total_bytes), 0)::bigint FROM hypertable_size('view_logs');",
                    "refId": "A"
                }
            ],
            "title": "Stockage total hypertables",
            "type": "stat"
        },
        {
            "datasource": { "type": "postgres", "uid": "timescaledb" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "custom": { "align": "auto", "displayMode": "auto" },
                    "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
                },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "compression_ratio" },
                        "properties": [{ "id": "unit", "value": "none" }, { "id": "decimals", "value": 2 }]
                    },
                    {
                        "matcher": { "id": "byName", "options": "total_size" },
                        "properties": [{ "id": "unit", "value": "bytes" }]
                    },
                    {
                        "matcher": { "id": "byName", "options": "compressed_size" },
                        "properties": [{ "id": "unit", "value": "bytes" }]
                    }
                ]
            },
            "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
            "id": 5,
            "options": {
                "showHeader": true,
                "sortBy": [{ "desc": true, "displayName": "total_size" }]
            },
            "targets": [
                {
                    "datasource": { "type": "postgres", "uid": "timescaledb" },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT h.hypertable_name AS table_name, (SELECT count(*) FROM timescaledb_information.chunks c WHERE c.hypertable_name = h.hypertable_name) AS chunks, (SELECT count(*) FROM timescaledb_information.chunks c WHERE c.hypertable_name = h.hypertable_name AND c.is_compressed) AS compressed_chunks, hypertable_size(format('%I.%I', h.hypertable_schema, h.hypertable_name)::regclass) AS total_size, COALESCE((SELECT sum(after_compression_total_bytes) FROM hypertable_compression_stats(format('%I.%I', h.hypertable_schema, h.hypertable_name)::regclass)), 0) AS compressed_size, CASE WHEN COALESCE((SELECT sum(after_compression_total_bytes) FROM hypertable_compression_stats(format('%I.%I', h.hypertable_schema, h.hypertable_name)::regclass)), 0) = 0 THEN NULL ELSE (SELECT sum(before_compression_total_bytes) FROM hypertable_compression_stats(format('%I.%I', h.hypertable_schema, h.hypertable_name)::regclass))::float / NULLIF((SELECT sum(after_compression_total_bytes) FROM hypertable_compression_stats(format('%I.%I', h.hypertable_schema, h.hypertable_name)::regclass)), 0) END AS compression_ratio FROM timescaledb_information.hypertables h ORDER BY total_size DESC;",
                    "refId": "A"
                }
            ],
            "title": "Hypertables - taille et compression",
            "type": "table"
        },
        {
            "datasource": { "type": "postgres", "uid": "timescaledb" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "custom": { "align": "auto", "displayMode": "auto" },
                    "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
                    "mappings": [
                        { "type": "value", "options": { "Success": { "color": "green" }, "Failed": { "color": "red" } } }
                    ]
                },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "last_run_status" },
                        "properties": [
                            { "id": "custom.displayMode", "value": "color-text" }
                        ]
                    }
                ]
            },
            "gridPos": { "h": 8, "w": 16, "x": 0, "y": 12 },
            "id": 6,
            "options": {
                "showHeader": true,
                "sortBy": [{ "desc": false, "displayName": "hypertable_name" }]
            },
            "targets": [
                {
                    "datasource": { "type": "postgres", "uid": "timescaledb" },
                    "format": "table",
                    "rawQuery": true,
                    "rawSql": "SELECT j.job_id, j.hypertable_name, j.proc_name AS policy, j.schedule_interval::text, s.last_run_started_at, s.last_run_status, s.next_start FROM timescaledb_information.jobs j LEFT JOIN timescaledb_information.job_stats s USING (job_id) WHERE j.proc_name IN ('policy_compression', 'policy_retention') ORDER BY j.hypertable_name, j.proc_name;",
                    "refId": "A"
                }
            ],
            "title": "Policies actives (compression + retention)",
            "type": "table"
        },
        {
            "datasource": { "type": "postgres", "uid": "timescaledb" },
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "palette-classic" },
                    "custom": {
                        "axisPlacement": "auto",
                        "drawStyle": "bars",
                        "fillOpacity": 60,
                        "lineWidth": 1,
                        "stacking": { "mode": "normal" }
                    },
                    "unit": "none"
                }
            },
            "gridPos": { "h": 8, "w": 16, "x": 0, "y": 20 },
            "id": 7,
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom" },
                "tooltip": { "mode": "multi" }
            },
            "targets": [
                {
                    "datasource": { "type": "postgres", "uid": "timescaledb" },
                    "format": "time_series",
                    "rawQuery": true,
                    "rawSql": "SELECT date_trunc('day', range_start) AS time, hypertable_name AS metric, count(*)::int AS value FROM timescaledb_information.chunks WHERE $__timeFilter(range_start) GROUP BY 1, 2 ORDER BY 1;",
                    "refId": "A"
                }
            ],
            "title": "Chunks créés par jour",
            "type": "timeseries"
        }
    ],
    "refresh": "30s",
    "schemaVersion": 39,
    "tags": ["timescaledb", "infra", "ops"],
    "templating": { "list": [] },
    "time": { "from": "now-7d", "to": "now" },
    "timepicker": {},
    "timezone": "browser",
    "title": "TimescaleDB - Ops & Compression",
    "uid": "timescaledb-ops",
