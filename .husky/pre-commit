#!/usr/bin/env sh

GIT_ROOT=$(git rev-parse --show-toplevel)

# ── Frontend : lint-staged sur fichiers JS/TS/Vue ───────────────────────────
FRONTEND_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|vue|js|mjs|cjs)$' || true)
if [ -n "$FRONTEND_STAGED" ]; then
    echo "→ Lint frontend staged files…"
    cd "$GIT_ROOT/apps/client" && pnpm exec lint-staged && cd "$GIT_ROOT"
fi

# ── Backend : pre-commit hooks sur fichiers Python ───────────────────────────
PYTHON_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)
if [ -n "$PYTHON_STAGED" ] && command -v pre-commit >/dev/null 2>&1; then
    echo "→ Lint Python staged files…"
    echo "$PYTHON_STAGED" | xargs pre-commit run --files
fi
