#!/usr/bin/env sh

GIT_ROOT=$(git rev-parse --show-toplevel)

# ── Frontend : lint-staged sur fichiers JS/TS/Vue ───────────────────────────
FRONTEND_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|vue|js|mjs|cjs)$' || true)
if [ -n "$FRONTEND_STAGED" ]; then
    echo "→ Lint frontend staged files…"
    cd "$GIT_ROOT/apps/client" && bunx lint-staged && cd "$GIT_ROOT"
fi

# ── Pre-commit hooks (Python lint, secrets, Dockerfiles…) ───────────────────
# Hooks gate themselves via `files:` patterns in .pre-commit-config.yaml.
if command -v pre-commit >/dev/null 2>&1; then
    echo "→ pre-commit hooks (gitleaks, hadolint, black/isort/ruff, …)…"
    pre-commit run --hook-stage pre-commit
fi
