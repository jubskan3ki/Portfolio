# ============================================
# Portfolio — Environment Variables
# Copy to .env and fill in values
# ============================================

# ── Django ───────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ── Email / Admin ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── JWT ──────────────────────────────────────
JWT_SECRET_ACCESS_KEY=

# ── Queue / Cache ────────────────────────────
RABBITMQ_USER=celery_user
RABBITMQ_PASS=celery_password

# ── Nuxt ─────────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_API_BASE_SERVER=http://backend:8000
NUXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=1
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Docker Ports ─────────────────────────────
SERVER_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── Docker Build Versions ────────────────────
# NODE_VERSION=24
# PNPM_VERSION=10.28.0
# PYTHON_VERSION=3.13
# POSTGRES_VERSION=17.2
# REDIS_VERSION=7.4
# RABBITMQ_VERSION=4
# NGINX_VERSION=1.27

# ── Backend Tuning ───────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30

# ── Celery Tuning ────────────────────────────
# CELERY_CONCURRENCY=2
# CELERY_LOG_LEVEL=INFO
# CELERY_MAX_TASKS_PER_CHILD=1000

# ── Redis Tuning ─────────────────────────────
# REDIS_MAXMEMORY=256mb

# ── PgBouncer Tuning ────────────────────────
# PGBOUNCER_POOL_MODE=transaction
# PGBOUNCER_DEFAULT_POOL_SIZE=20
# PGBOUNCER_MAX_CLIENT_CONN=100
# PGBOUNCER_MIN_POOL_SIZE=5

# ── Logging ──────────────────────────────────
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3

# ── Dev Tools Ports (profile: dev) ──────────
# SWAGGER_PORT=8085
# PGADMIN_PORT=5050
# PGADMIN_EMAIL=admin@portfolio.dev

# ── Monitoring Ports (profile: monitoring) ───
# GRAFANA_PORT=3001
# GRAFANA_DOMAIN=localhost
# GRAFANA_ROOT_URL=http://localhost:3001
# PROMETHEUS_PORT=9090
# PROMETHEUS_RETENTION=15d
# LOKI_PORT=3100
# CADVISOR_PORT=8080

# ── Backup (profile: backup) ────────────────
# BACKUP_PATH=./backups
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=7
# BACKUP_KEEP_WEEKS=4
# BACKUP_KEEP_MONTHS=6
