# Portfolio | Environment Variables. Copy to .env and fill in values.

# ── Django ───────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# DJANGO_ENV selects config/settings/envs/<env>.py overrides (dev|prod)
DJANGO_ENV=dev
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────
DB_NAME=portfolio_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ── Email / Admin ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── JWT ──────────────────────────────────────
JWT_SECRET_ACCESS_KEY=

# ── Queue / Cache ────────────────────────────
RABBITMQ_USER=celery_user
RABBITMQ_PASS=celery_password

# ── Nuxt ─────────────────────────────────────
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_API_BASE_SERVER=http://backend:8000
NUXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=1
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Docker Ports ─────────────────────────────
SERVER_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── Deployment / SSL ─────────────────────────
# Required for: make ssl-issue, make ssl-renew, make healthcheck, make deploy
DOMAIN=aitaddajuba.fr
EMAIL=contact@aitaddajuba.fr
# Use Let's Encrypt staging for dry-run tests (1 = staging, 0 = prod)
CERTBOT_STAGING=0
# SSH target (used by 'make deploy-remote' if invoked from a dev machine)
SSH_USER=
SSH_HOST=
SSH_PORT=22
DEPLOY_PATH=/home/ubuntu/projects/Portfolio

# ── Docker Build Versions ────────────────────
# NODE_VERSION=24
# PNPM_VERSION=10.28.0
# PYTHON_VERSION=3.13
# TIMESCALEDB_VERSION=2.18.2-pg17   # image timescale/timescaledb (remplace postgres:17)
# TIMESCALEDB_TELEMETRY=off          # désactive le ping anonyme vers Timescale Inc.
# REDIS_VERSION=7.4
# RABBITMQ_VERSION=4
# NGINX_VERSION=1.27

# ── Backend Tuning ───────────────────────────
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
# Doit être <= `stop_grace_period` du service backend (60s) pour drain propre SIGTERM.
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5

# ── Celery Tuning ────────────────────────────
# CELERY_CONCURRENCY=2
# CELERY_LOG_LEVEL=INFO
# CELERY_MAX_TASKS_PER_CHILD=1000
# Max time celery waits for current tasks on SIGTERM (compose stop_grace_period=90s).
CELERY_SHUTDOWN_TIMEOUT=60

# ── Redis Tuning ─────────────────────────────
# REDIS_MAXMEMORY=256mb

# ── PgBouncer Tuning ────────────────────────
# PGBOUNCER_POOL_MODE=transaction
# PGBOUNCER_DEFAULT_POOL_SIZE=20
# PGBOUNCER_MAX_CLIENT_CONN=100
# PGBOUNCER_MIN_POOL_SIZE=5

# ── Logging ──────────────────────────────────
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3

# ── MinIO / S3 storage (medias) ──────────────
MINIO_ROOT_USER=portfolio-admin
MINIO_ROOT_PASSWORD=
USE_S3=true
S3_BUCKET_NAME=portfolio-media
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_PUBLIC_READ=true
S3_ENDPOINT_URL=http://minio:9000
# Domaine public (sans protocole) : dev=localhost:9000/portfolio-media, prod=media.aitaddajuba.fr
S3_PUBLIC_DOMAIN=localhost:9000/portfolio-media
S3_PUBLIC_PROTOCOL=http
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_CONSOLE_URL=http://localhost:9001
# MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
# MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z

# ── Dev Tools Ports (profile: dev) ──────────
# SWAGGER_PORT=8085
# PGADMIN_PORT=5050
# PGADMIN_EMAIL=admin@portfolio.dev

# ── Monitoring Ports (profile: monitoring) ───
# GRAFANA_PORT=3001
# GRAFANA_DOMAIN=localhost
# GRAFANA_ROOT_URL=http://localhost:3001
# PROMETHEUS_PORT=9090
# PROMETHEUS_RETENTION=15d
# LOKI_PORT=3100
# CADVISOR_PORT=8080

# ── Backup (profile: backup) ────────────────
# BACKUP_PATH=./backups
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=7
# BACKUP_KEEP_WEEKS=4
# BACKUP_KEEP_MONTHS=6

# ── Traefik (requis pour demarrage | dashboard BasicAuth) ───
DASHBOARD_BASIC_AUTH=admin:$2y$05$CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# TRAEFIK_HTTP_PORT=80
# TRAEFIK_HTTPS_PORT=443
# TRAEFIK_METRICS_PORT=8082
# Sampling OTel côté Traefik : 1.0 en dev, 0.1 en prod pour limiter volume.
# TRAEFIK_TRACING_SAMPLE_RATE=1.0

# ── Observability (profile: monitoring) ─
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Sampling rate: 1.0 en dev, 0.1 en prod pour limiter volume.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
# URLs consommées par /api/public/status/
PROMETHEUS_INTERNAL_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
# Webhook Alertmanager (SLO burn rate, TargetDown).
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ALERTMANAGER_PORT=9093

# ── CI / Registry (défini automatiquement par GitLab CI) ─
# CI_REGISTRY_IMAGE=registry.gitlab.com/user/portfolio
# IMAGE_TAG=latest
# BUILD_DATE=2026-04-18T00:00:00Z
