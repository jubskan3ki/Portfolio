# .gitignore | Portfolio Monorepo

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
__MACOSX/
*.orig
*.rej
*.bak
*.tmp
*.swp
*.swo
*.swn
*.~lock
*.log
core.*
*.dmp
*.cpuprofile
*.heapsnapshot
*.heapprofile

# ── Secrets & Environment ────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example

# Decrypted sops output | only the encrypted *.sops.yaml files are tracked
/run/secrets/
secrets/*.env
!secrets/*.env.sops.yaml
!secrets/.gitkeep
!secrets/README.md

# Age private keys must never land in the repo
*.age
age-key.txt
keys.txt

# Ansible vault files (encrypted or decrypted) | only *.example is tracked
ansible/group_vars/**/vault.yml
ansible/group_vars/**/vault.yaml
!ansible/group_vars/**/vault.yml.example
ansible/.vault_pass
ansible/*.retry

# Direnv
.envrc.local
.direnv/

# ── Python & Django ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pot
*.mo
*.sqlite3
local_settings.py
celerybeat-schedule
celerybeat.pid
*.pid

# Collected static / uploaded media + runtime logs
apps/server/staticfiles/
apps/server/media/
apps/server/logs/

# Python packaging
*.egg-info/
*.egg
dist/
build/

# Virtual environments
.venv/
venv/
env/
.virtualenv/

# Type checking & linting caches
.mypy_cache/
.ruff_cache/
.pylint.d/
.dmypy.json
.pyright/
.pyre/
.pytype/

# Testing
.tox/
.nox/
.coverage
coverage.xml
htmlcov/
junit.xml
.pytest_cache/
.hypothesis/
nosetests.xml

# ── Node.js & Nuxt ───────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
.nuxt/
.output/
.nitro/
.vite/
.turbo/
dist/
.cache/
.eslintcache
*.tsbuildinfo
.stylelintcache
bun.lockb

# IPX image cache (@nuxt/image)
.ipx/

# Vite generated config snapshot files (timestamped)
vite.config.*.timestamp-*
vitest.config.*.timestamp-*

# Playwright / Vitest artefacts
playwright-report/
test-results/
.vitest-cache/
blob-report/
*.snapshots/

# Bundle analyzer output
.nuxt-analyze/
stats.html

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Non-pnpm lockfiles (projet utilise pnpm)
package-lock.json
yarn.lock

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml
docker-compose.override.yaml

# ── Backups & Data persistants ───────────────────────────────
backups/
postgres-data/
redis-data/
rabbitmq-data/
pgbouncer-data/
monitoring/grafana/data/
monitoring/loki/
monitoring/prometheus/data/
monitoring/alertmanager/data/
monitoring/tempo/data/

# Exports JSON locaux (données personnelles | ne jamais push)
/data/*
!/data/.gitkeep

# Let's Encrypt / certbot (généré au runtime)
letsencrypt/
certbot/
nginx/certbot-www/
nginx/letsencrypt/

# Traefik ACME storage (contient la clé privée !)
traefik/acme.json
traefik/acme/

# Infra as Code state
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/crash.log
*.auto.tfvars

# k6 / bench results
bench/results/
bench/*.json
!bench/scenarios/*.js

# ── Lighthouse CI ────────────────────────────────────────────
**/.lighthouseci/
lhr-*.html
lhr-*.json

# ── IDEs & Éditeurs ──────────────────────────────────────────
.idea/
*.sublime-workspace
*.sublime-project
.vscode/*
!.vscode/settings.recommended.json
!.vscode/extensions.json
!.vscode/launch.json
.history/
.zed/


# AI tooling (caches, sessions, project-local configs)
CLAUDE.md
CONTEXT/
claude.config.json
.claude/
.aider*
.continue/
.cursor/
.cursorrules
.cursorignore
.dccache
.specstory/
.windsurf*
.codeium/
.copilotignore.local

# Local-only overrides (never push)
*.local
*.local.json
*.local.yaml
*.local.yml
!package-lock.json
pyrightconfig.local.json
