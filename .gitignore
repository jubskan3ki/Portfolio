# ============================================================
# .gitignore — Portfolio Monorepo
# ============================================================

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
__MACOSX/
*.orig
*.rej
*.bak
*.tmp
*.swp
*.swo
*.swn
*.~lock

# ── Secrets & Environment ────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example

# ── Python & Django ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pot
*.mo
*.sqlite3
local_settings.py
celerybeat-schedule
celerybeat.pid
*.pid

# Collected static / uploaded media
apps/server/staticfiles/
apps/server/media/

# Python packaging
*.egg-info/
*.egg
dist/
build/

# Virtual environments
.venv/
venv/
env/
.virtualenv/

# Type checking & linting caches
.mypy_cache/
.ruff_cache/
.pylint.d/

# Testing
.tox/
.nox/
.coverage
coverage.xml
htmlcov/
junit.xml
.pytest_cache/
.hypothesis/
nosetests.xml

# ── Node.js & Nuxt ───────────────────────────────────────────
node_modules/
.npm/
.nuxt/
.output/
.nitro/
.vite/
.turbo/
dist/
.cache/
.eslintcache

# Logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Non-pnpm lockfiles (projet utilise pnpm)
package-lock.json
yarn.lock

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml
docker-compose.override.yaml

# ── Backups & Data persistants ───────────────────────────────
backups/
postgres-data/
monitoring/grafana/data/
monitoring/loki/

# ── Lighthouse CI ────────────────────────────────────────────
**/.lighthouseci/
lhr-*.html
lhr-*.json

# ── IDEs & Éditeurs ──────────────────────────────────────────
.idea/
*.sublime-workspace
*.sublime-project


# --- Claude Code (AI tooling) --- #
CLAUDE.md
CONTEXT/
claude.config.json
.claude/
