# ── Django ───────────────────────────────────
DJANGO_SECRET_KEY=          # REQUIRED: generate with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_DEBUG=false
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,backend
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ── Database ─────────────────────────────────
DB_NAME=portfolio_db
DB_USER=portfolio_user      # REQUIRED: use a dedicated user, not 'postgres'
DB_PASSWORD=                # REQUIRED: strong password (32+ chars)
DB_HOST=db
DB_PORT=5432

# ── Email / Admin ────────────────────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=                  # REQUIRED
SMTP_PASS=                  # REQUIRED
EMAIL_FROM=noreply@your-domain.com
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=             # REQUIRED: strong password

# ── JWT ──────────────────────────────────────
JWT_SECRET_ACCESS_KEY=      # REQUIRED: generate with `openssl rand -hex 64`

# ── Queue / Cache ────────────────────────────
RABBITMQ_USER=celery_prod   # Change default credentials
RABBITMQ_PASS=              # REQUIRED: strong password

# ── Nuxt ─────────────────────────────────────
NUXT_PUBLIC_API_BASE=https://your-domain.com
NUXT_API_BASE_SERVER=http://backend:8000
NUXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
NUXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Docker Ports (internal, behind nginx/reverse proxy) ──
SERVER_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
# Don't expose these in production | keep behind firewall:
POSTGRES_PORT=127.0.0.1:5432
REDIS_PORT=127.0.0.1:6379
RABBITMQ_PORT=127.0.0.1:5672
RABBITMQ_MANAGEMENT_PORT=127.0.0.1:15672

# ── Backend Tuning ───────────────────────────
GUNICORN_WORKERS=4          # Recommended: (2 × CPU cores) + 1
GUNICORN_TIMEOUT=30

# ── Celery Tuning ────────────────────────────
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=WARNING
CELERY_MAX_TASKS_PER_CHILD=500

# ── Redis Tuning ─────────────────────────────
REDIS_MAXMEMORY=512mb

# ── PgBouncer Tuning ────────────────────────
PGBOUNCER_DEFAULT_POOL_SIZE=30
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_MIN_POOL_SIZE=10

# ── Logging ──────────────────────────────────
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# ── Backup ───────────────────────────────────
BACKUP_PATH=/var/backups/portfolio
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# ── Monitoring (optional) ───────────────────
# GRAFANA_PORT=3001
# GRAFANA_DOMAIN=your-domain.com
# GRAFANA_ROOT_URL=https://your-domain.com/grafana
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=   # Separate from ADMIN_PASSWORD
# PROMETHEUS_RETENTION=30d
